# Copy this file to .env and fill in your values.

PORT=5000

# Local MongoDB (see README "Connecting MongoDB")
MONGODB_URI=mongodb://127.0.0.1:27017/signup_app

# MongoDB Atlas alternative (replace the placeholders):
# MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/signup_app?retryWrites=true&w=majority

CLIENT_ORIGIN=http://localhost:5173
